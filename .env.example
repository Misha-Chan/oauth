# ============================================================
# oauth.hostaka.fun — نموذج متغيرات البيئة
# انسخه إلى .env ثم عدّل القيم: cp .env.example .env
# لا ترفع ملف .env إلى المستودع أبداً.
# ============================================================

# التحقق من توقيع JWT قبل قبول أي توكن (1 = مفعّل، 0 = معطّل).
# مفعّل افتراضياً — لا تضبطه 0 إلا اضطراراً (غير آمن).
VERIFY_TOKENS=1

# نفس قيمة JWT_SECRET المضبوطة بمشروع hostaka-main بالضبط (16 حرفاً على الأقل).
# مطلوب دائماً عندما VERIFY_TOKENS مفعّل — بدون أي قيمة افتراضية بالكود.
JWT_SECRET=

# نطاق الكوكي المشترك بين النطاقات الفرعية.
COOKIE_DOMAIN=.hostaka.fun

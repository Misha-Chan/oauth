# ============================================================
# oauth.hostaka.fun — نموذج متغيرات البيئة
# انسخه إلى .env ثم عدّل القيم: cp .env.example .env
# لا ترفع ملف .env إلى المستودع أبداً.
# ============================================================

# فعّل التحقق من توقيع JWT قبل قبول أي توكن (1 = مفعّل، 0 = معطّل).
# اتركه 0 لحد ما تتأكد أن التدفق الأساسي شغّال.
VERIFY_TOKENS=0

# نفس قيمة JWT_SECRET المضبوطة بمشروع hostaka-main بالضبط.
# مطلوب فقط إذا كان VERIFY_TOKENS=1 — بدون أي قيمة افتراضية بالكود.
JWT_SECRET=

# نطاق الكوكي المشترك بين النطاقات الفرعية.
COOKIE_DOMAIN=.hostaka.fun
